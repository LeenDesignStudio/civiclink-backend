{
  "name": "civiclink-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:up": "docker compose up -d db",
    "prisma:generate": "prisma generate",
    "schema:print": "tsx scripts/print-schema.ts",
    "docs:api": "tsx scripts/generate-api-reference.ts",
    "format": "prettier --write .",
    "prepare": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-sesv2": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/helmet": "^13.1.1",
    "@graphql-yoga/plugin-csrf-prevention": "^3.24.1",
    "@pothos/core": "^4.15.1",
    "@pothos/plugin-scope-auth": "^4.2.1",
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "@sentry/node": "^11.4.0",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.24.4",
    "jose": "^6.2.12",
    "libphonenumber-js": "^1.13.14",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "pg-boss": "^12.36.0",
    "pino": "^10.4.0",
    "prisma": "~7.10.0",
    "rate-limiter-flexible": "^11.2.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
