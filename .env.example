# CivicLink API — environment template. Copy to .env for local development.
# Every key is validated by src/config/env.ts at boot. Never commit real secrets.
# In staging/production these come from AWS Secrets Manager.

APP_ENV=development
PORT=4000
LOG_LEVEL=debug
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# No Docker (docs/07): paste the five lines printed by server/install-dev-db.sh (port 5433 = SSH tunnel).
# Docker: use the values below (match docker/postgres-init) and drop the TEST_* lines.
# Runtime connection: DML-only app role
DATABASE_URL=postgresql://civiclink_app:app_dev_password@localhost:5432/civiclink
# Migrations only (prisma.config.ts): owner role
MIGRATION_DATABASE_URL=postgresql://civiclink_owner:owner_dev_password@localhost:5432/civiclink
SHADOW_DATABASE_URL=postgresql://civiclink_owner:owner_dev_password@localhost:5432/civiclink_shadow
# Integration tests without Docker (database name must end in _test)
TEST_DATABASE_URL=
TEST_MIGRATION_DATABASE_URL=
DB_POOL_MAX=10

# --- Tokens & crypto (generate locally; see README "Generate dev secrets") ---
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_KEY_ID=dev-1
JWT_PREVIOUS_PUBLIC_KEY=
COOKIE_ENC_KEY=
LINK_SIGNING_SECRET=
IP_HASH_SECRET=

# --- Resident sign-in ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Admin sign-in (separate Google OAuth client) ---
ADMIN_GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_CLIENT_SECRET=
ADMIN_GOOGLE_HD=qubalink.com
BOOTSTRAP_SUPER_ADMIN_EMAIL=

# --- Providers ---
GOOGLE_MAPS_API_KEY=
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
EMAIL_PROVIDER=console
EMAIL_FROM="CivicLink <no-reply@civiclink.local>"
CONTACT_INBOX=hello@qubalink.com
PUSH_PROVIDER=console
FCM_SERVICE_ACCOUNT_JSON=
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=

# --- AWS ---
AWS_REGION=us-east-1
S3_BUCKET_EXPORTS=civiclink-dev-exports
S3_BUCKET_SNAPSHOTS=civiclink-dev-snapshots
# Optional. When set, staging/production export uploads use aws:kms with this key. Otherwise AES256.
S3_EXPORTS_KMS_KEY_ID=

# --- Product defaults (decisions D-07, D-08, D-10) ---
LIMIT_DEFAULT_MAX_SAVED_LOCATIONS=5
LIMIT_DEFAULT_MAX_FOLLOWS=50
ACCOUNT_PURGE_DAYS=30
ANON_LOOKUP_TTL_DAYS=30
FRESHNESS_DEFAULT_DAYS=90

GRAPHQL_INTROSPECTION=true
